# Root gitignore

# Server build outputs
server/target/
server/*.releaseBackup

# Secrets
**/.env

# Frontend dependencies and builds
frontend/node_modules/
frontend/dist/
frontend/.next/
frontend/out/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*

# IDEs and Editors
.idea/
*.iml
.vscode/
.settings/
.classpath
.project
.metadata/

# Internal Reference Docs
docs/PRD.md
docs/implementation_plan.md
docs/priority_1_team_management_guide.md
docs/scripts/

