# Phase 2: Neon Cloud PostgreSQL (any prefered cloud database)
DB_URL=jdbc:postgresql://ep-your-project-id.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your_neon_password
